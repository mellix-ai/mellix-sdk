{
  "name": "mellix",
  "version": "0.0.1",
  "description": "JavaScript/TypeScript client for the Mellix Decision API",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Charlie Hudson",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.js test/batches.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mellix",
    "decision",
    "api",
    "llm"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mellix-ai/mellix-sdk.git",
    "directory": "js"
  },
  "homepage": "https://www.mellix.ai/docs",
  "bugs": {
    "url": "https://github.com/mellix-ai/mellix-sdk/issues"
  }
}
